#!/usr/bin/env bash
# Format staged Go files before commit (matches CI gofmt gate).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r f; do
	[[ -n "$f" ]] && files+=("$f")
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)
EOF

if ((${#files[@]} == 0)); then
	exit 0
fi

for f in "${files[@]}"; do
	if [[ -f "$f" ]]; then
		gofmt -w "$f"
		git add "$f"
	fi
done

unformatted="$(gofmt -l "${files[@]}")"
if [[ -n "$unformatted" ]]; then
	echo "gofmt: still unformatted after write:" >&2
	echo "$unformatted" >&2
	exit 1
fi
